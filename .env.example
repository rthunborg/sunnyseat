# Docker Compose project names
# compose.yaml defaults to "sunnyseat"; compose.test.yaml defaults to "sunnyseat-test".
# Prefer setting COMPOSE_PROJECT_NAME in the shell per command/session for
# concurrent agent runs. Do not set one shared value in .env when dev and test
# stacks need to run at the same time.
# COMPOSE_PROJECT_NAME=sunnyseat-local

# Persistent development PostGIS database.
POSTGRES_PORT=15432
POSTGRES_DB=sunnyseat_dev
POSTGRES_USER=sunnyseat
POSTGRES_PASSWORD=sunnyseat_dev_password
DATABASE_URL=postgresql://sunnyseat:sunnyseat_dev_password@127.0.0.1:15432/sunnyseat_dev
DATABASE_URL_IN_COMPOSE=postgresql://sunnyseat:sunnyseat_dev_password@postgres:5432/sunnyseat_dev

# Disposable test PostGIS database.
TEST_POSTGRES_PORT=15433
TEST_POSTGRES_DB=sunnyseat_test
TEST_POSTGRES_USER=sunnyseat_test
TEST_POSTGRES_PASSWORD=sunnyseat_test_password
TEST_DATABASE_URL=postgresql://sunnyseat_test:sunnyseat_test_password@127.0.0.1:15433/sunnyseat_test
TEST_DATABASE_URL_IN_COMPOSE=postgresql://sunnyseat_test:sunnyseat_test_password@postgres:5432/sunnyseat_test
