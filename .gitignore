.claude/worktrees/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test results
coverage/

# BMAD framework is reinstallable local tooling. BMAD output is project-owned
# planning, sprint, and QA context and should travel with the repository.
_bmad/
scripts/*
!scripts/story-review.sh
!scripts/visual-validate.sh
!scripts/fetch-claude-design.sh
!scripts/run-sh.ps1
!scripts/geodata/
!scripts/geodata/**
scripts/geodata/**/__pycache__/
scripts/geodata/**/*.py[cod]

# Codex workflow files are project-owned; personal Codex state remains ignored by
# default unless explicitly unignored here.
.codex/*
!.codex/config.toml
!.codex/hooks.json
!.codex/scripts/
!.codex/scripts/**

# Installed agent skills are disposable local framework content. A fresh clone
# should reinstall BMAD/Codex skills locally. SunnySeat tracks only the
# project-binding skills referenced from AGENTS.md and project-context.md.
.agents/skills/*
!.agents/skills/frontend-component/
!.agents/skills/frontend-component/**
!.agents/skills/visual-validation/
!.agents/skills/visual-validation/**
!.agents/skills/test-gate/
!.agents/skills/test-gate/**
!.agents/skills/bmad-story-brief/
!.agents/skills/bmad-story-brief/**
!.agents/skills/review-round-guard/
!.agents/skills/review-round-guard/**
!.agents/skills/story-file-audit/
!.agents/skills/story-file-audit/**

# Geodata (large binary, imported once)
building_geodata/

# Local-only docs
*.local.md

# Git worktrees
.worktrees/

# Local agent/tooling config (machine-specific; may carry tokens/link state)
.mcp.json
supabase/
