# Dependencies
node_modules/

# Next.js
.next/
out/

# Environment files (contain secrets)
.env*.local

# IDE / Editor
.vscode/
.idea/
.cursor/
.claude/*
!.claude/scripts/
.claude/settings*.json
.claude/worktrees/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test results
coverage/

# BMAD framework is reinstallable local tooling. BMAD output is project-owned
# planning, sprint, and QA context and should travel with the repository.
_bmad/
scripts/*
!scripts/story-review.sh
!scripts/visual-validate.sh
!scripts/fetch-claude-design.sh
!scripts/run-sh.ps1

# Codex workflow files are project-owned; personal Codex state remains ignored by
# default unless explicitly unignored here.
.codex/*
!.codex/config.toml
!.codex/hooks.json
!.codex/scripts/
!.codex/scripts/**

# Generic BMAD/WDS skill mirrors are disposable local framework content for this
# migration. SunnySeat keeps only custom/project-binding skills here; tracked
# files remain tracked regardless of ignore rules.
.agents/skills/bmad-*/
!.agents/skills/bmad-story-brief/
!.agents/skills/bmad-story-brief/SKILL.md
.agents/skills/wds-*/
.agents/skills/wds-agent-*/

# Geodata (large binary, imported once)
building_geodata/

# Local-only docs
*.local.md

# Git worktrees
.worktrees/
