# SunnySeat environment variables (example).
#
# SECRET POLICY (AGENTS.md §Secrets): never commit real values. `.env.local`
# stays gitignored; production secrets live ONLY in Vercel env vars. A
# NEXT_PUBLIC_ prefix INLINES the value into the client bundle at build time, so
# it must NEVER hold a secret. Only the Supabase URL may be NEXT_PUBLIC_. The
# service-role key, the Met.no User-Agent, and the SUNNYSEAT_* flags are
# SERVER-ONLY.

# --- Supabase -----------------------------------------------------------------
# Public (safe to expose): the project URL. There is NO anon/browser Supabase
# client — all data access is server-side via the service-role client behind
# /api/*, so no NEXT_PUBLIC_SUPABASE_ANON_KEY is needed.
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
# SECRET, server-only. Bypasses RLS. Set per environment in Vercel; never
# NEXT_PUBLIC_, never committed.
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

# Direct GitHub Actions hours audit (Story 12.1). GitHub's protected Production
# environment uses SUPABASE_URL (non-public name) plus the same server-only key.
# The emergency stop is fail-closed: only the exact string "true" enables a run.
SUPABASE_URL=https://[project].supabase.co
SUN_HOURS_AUDIT_ENABLED=false
SUN_GEOMETRY_PRECOMPUTE_ENABLED=false
SUN_WEATHER_REFRESH_ENABLED=false

# --- Data-source adapters (server-only) ---------------------------------------
# Unset = in-memory fixture/seed default (CI + local have ZERO live-Supabase
# dependency, and the route output is byte-identical to the fixture era). Set to
# "supabase" to read/write the live tables via the service-role client. Each
# requires NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above.
# Story 8.5: these are flipped on for the PRODUCTION environment only (in Vercel),
# never in committed CI/test config.
SUNNYSEAT_VENUE_STORE=          # "supabase" reads public.venues (Story 8.2)
SUNNYSEAT_FEEDBACK_PERSISTENCE= # "supabase" writes public.feedback (Story 3.2)
SUNNYSEAT_REVIEW_PERSISTENCE=   # "supabase" reads/writes public.reviews (Story 3.3)

# Sun engine (Story 8.3). Unset = the 8.2 seed sun values (byte-identical, CI
# default). "real" computes currentSunStatus/skyCondition/confidence/
# sunExposurePercent/sunWindow/predictionUncertainty live from lib/solar (shadow
# casting via the get_buildings_near_point RPC) + lib/weather (Met.no). Weather
# is a public API needing only the User-Agent below (no extra secret); "real"
# additionally requires the Supabase service-role config above (for the RPC),
# exactly like SUNNYSEAT_VENUE_STORE=supabase.
SUNNYSEAT_SUN_ENGINE=           # "real" computes live sun/shadow/weather (Story 8.3)

# --- Met.no weather API -------------------------------------------------------
# SERVER-ONLY, NOT a secret (it is a public identifier). Met.no TOS requires an
# identifying User-Agent WITH a real way to make contact (an email or URL). Set
# this per environment with a genuine contact address; if unset, the code falls
# back to a non-secret default carrying the maintainer contact-of-record (also
# TOS-compliant). Never NEXT_PUBLIC_.
MET_NO_USER_AGENT=SunnySeat/1.0 rasmus.thunborg@enhancior.se

# --- Application --------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local-only maintainer editor. Leave unset by default; set to "dev" only on a
# loopback development server when using /?_editor=venues.
SUNNYSEAT_ADMIN=

# --- Notes --------------------------------------------------------------------
# Map tiles: NO key is required. The map uses a keyless OpenFreeMap style
# (MapTiler was dropped in Story 1.4, decision D3=B), so there is no MAPTILER_KEY
# / tile-style secret to configure.
# Hours review is a direct GitHub Action with no /api/cron route and no
# CRON_SECRET. Configure its protected secrets/variable in GitHub, not Vercel.
