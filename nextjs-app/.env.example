# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

# Authentication
JWT_SECRET=[random-256-bit-secret]

# Cron job authentication
CRON_SECRET=[random-secret-for-cron-endpoints]

# MapTiler (map tiles for venue explorer)
NEXT_PUBLIC_MAPTILER_KEY=[maptiler-api-key]

# Met.no weather API (requires identifying User-Agent per TOS)
MET_NO_USER_AGENT=sunnyseat/1.0 [your-email@example.com]

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
