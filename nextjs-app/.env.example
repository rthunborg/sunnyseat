# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[project].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

# Data-source adapters (server-only). Unset = in-memory fixture default (CI has
# no live-Supabase dependency). Set to "supabase" to read the live tables via
# the service-role client. Requires NEXT_PUBLIC_SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY above.
SUNNYSEAT_VENUE_STORE=          # "supabase" reads public.venues (Story 8.2)
SUNNYSEAT_FEEDBACK_PERSISTENCE= # "supabase" writes public.feedback (Story 3.2)
SUNNYSEAT_REVIEW_PERSISTENCE=   # "supabase" reads/writes public.reviews (Story 3.3)

# Cron job authentication
CRON_SECRET=[random-secret-for-cron-endpoints]

# Met.no weather API (requires identifying User-Agent per TOS)
MET_NO_USER_AGENT=sunnyseat/1.0 [your-email@example.com]

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
